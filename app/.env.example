# ── Required ───────────────────────────────────────────────────
# 会话签名与平台令牌加密密钥。生产环境至少 32 个字符。
# 可用 `openssl rand -base64 48` 生成。修改后所有登录会话失效，
# Etsy / eBay 已存令牌也需要重新授权。
APP_SECRET=

# MySQL 连接串（本地开发）
DATABASE_URL=mysql://aew:aew_password@127.0.0.1:3306/aew

# ── Public origin ──────────────────────────────────────────────
# 本地：http://localhost:3000
# 线上：https://workbench.example.com
APP_ORIGIN=http://localhost:3000

# ── First admin (optional) ─────────────────────────────────────
# 首次启动时若 local_accounts 为空，会用这里创建管理员。
# 创建成功后请从生产环境变量中删除 ADMIN_PASSWORD。
ADMIN_NAME=店主
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Attachments ────────────────────────────────────────────────
# 自托管附件目录；Docker 部署时会挂载持久卷。
STORAGE_DIR=./data/uploads

# ── Etsy Open API v3 ───────────────────────────────────────────
# https://www.etsy.com/developers/your-apps
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=
ETSY_SHOP_ID=

# ── eBay REST API ──────────────────────────────────────────────
# https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_REDIRECT_URI=
EBAY_MARKETPLACE_ID=EBAY_AU
