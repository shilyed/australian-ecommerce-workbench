# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Public origin ───────────────────────────────────────────────
# 公网地址，用于拼装 OAuth 回调；本地开发可留空（回退到请求 origin）
APP_ORIGIN=

# ── Etsy Open API v3 ────────────────────────────────────────────
# 在 https://www.etsy.com/developers/your-apps 创建应用后获取
ETSY_CLIENT_ID=           # keystring
ETSY_CLIENT_SECRET=       # 可选：Etsy OAuth 走 PKCE，不强制
ETSY_REDIRECT_URI=        # 可选，默认 ${APP_ORIGIN}/api/integrations/etsy/callback
ETSY_SHOP_ID=             # 可选：固定绑定某个 shop_id；留空自动读取授权账号的店铺

# ── eBay REST API ───────────────────────────────────────────────
# 在 https://developer.ebay.com/my/keys 创建应用后获取
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production   # production | sandbox
EBAY_REDIRECT_URI=            # 必填：eBay 后台的 RuName，不是完整网址
EBAY_MARKETPLACE_ID=EBAY_AU
