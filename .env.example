# ── 公网入口 ───────────────────────────────────────────────────
# 没有域名时用 IP + 非 80 端口，例如：
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# APP_ORIGIN=http://123.123.123.123:8080
#
# 有域名且完成备案 / DNS 解析后：
# SITE_ADDRESS=workbench.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
# APP_ORIGIN=https://workbench.example.com
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=443
APP_ORIGIN=http://YOUR_SERVER_IP:8080

# ── Required secrets ───────────────────────────────────────────
# openssl rand -base64 48
APP_SECRET=
MYSQL_DATABASE=aew
MYSQL_USER=aew
# 建议使用 `openssl rand -hex 24`，避免 @ : / 等字符破坏连接串
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── First administrator ────────────────────────────────────────
# 首次启动自动创建管理员；成功后请删除 ADMIN_PASSWORD。
ADMIN_NAME=店主
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Etsy Open API v3（可选） ───────────────────────────────────
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=
ETSY_SHOP_ID=

# ── eBay REST API（可选） ──────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_REDIRECT_URI=
EBAY_MARKETPLACE_ID=EBAY_AU
