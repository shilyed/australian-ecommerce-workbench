# Only ATB_* variables are read. Never reuse the website's .env.
# CLI: --env-file .env (no interpolation); Compose: --env-file .env
ATB_DATA_DIR=data

ATB_EBAY_CLIENT_ID=
ATB_EBAY_CLIENT_SECRET=
# Alternative to client credentials; expiry/refresh is then your responsibility.
ATB_EBAY_ACCESS_TOKEN=

# Explicit opt-in BEFORE any Apify or SerpApi paid call. No subscription is created.
ATB_ALLOW_PAID_PROVIDERS=false
ATB_APIFY_TOKEN=
ATB_SERPAPI_KEY=

ATB_AI_ENABLED=false
ATB_AI_PUBLIC_EVIDENCE_CONSENT=false
ATB_DEEPSEEK_API_KEY=
ATB_DEEPSEEK_BASE_URL=https://api.deepseek.com
ATB_DEEPSEEK_MODEL=deepseek-flash

# none | smtp | webhook. SMTP always uses TLS (465 SSL or 587 STARTTLS).
ATB_NOTIFICATION=none
ATB_SMTP_HOST=
ATB_SMTP_PORT=587
ATB_SMTP_USER=
ATB_SMTP_PASSWORD=
ATB_SMTP_FROM=
ATB_SMTP_TO=
# HTTPS endpoint receives JSON with HTML/CSV and a stable Idempotency-Key header.
ATB_WEBHOOK_URL=
ATB_WEBHOOK_BEARER=
